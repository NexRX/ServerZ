{
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "rust": "html",
          "Rust": "html",
        },
        "configFile": "styles.css",
        "experimental": {
          "classRegex": [["class!\\(([^)]*)\\)", "\"([^\"]*)\""]],
        },
      },
    },
  },
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer", "tailwindcss-language-server"],
    },
  },
}
