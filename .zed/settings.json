{
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "rust": "html",
          "Rust": "html",
        },
        "configFile": "styles.css",
        "experimental": {
          "classRegex": [
            "tw!\\(\\s*\"([^\"]*)\"",
            ["class!\\(([^)]*)\\)", "\"([^\"]*)\""],
            "class=\"([^\"]*)\"",
          ],
        },
      },
    },
  },
  "languages": {
    "Rust": {
      "language_servers": ["rust-analyzer", "tailwindcss-language-server"],
      "formatter": {
        "external": {
          "command": "topcoat",
          "arguments": ["fmt", "--stdin", "--rustfmt"],
        },
      },
      "completions": {
        "words": "enabled",
      },
    },
  },
}
