{
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "rust": "html",
          "Rust": "html"
        },
        "experimental": {
          "classRegex": [
            ["class!\\(([^)]*)\\)", "\"([^\"]*)\""]
          ]
        }
      }
    }
  },
  "languages": {
    "Rust": {
      "language_servers": [
        "rust-analyzer",
        "tailwindcss-language-server"
      ]
    }
  }
}
